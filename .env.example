# Copy to .env (never commit it) or set these in your shell / cloud environment.
# Names are prefixed with AIM_ so they never clash with tools that read
# OPENAI_API_KEY / ANTHROPIC_API_KEY themselves.

AIM_OPENAI_API_KEY=
AIM_ANTHROPIC_API_KEY=

# Optional endpoint overrides (leave empty for the public APIs).
AIM_OPENAI_BASE_URL=
AIM_ANTHROPIC_BASE_URL=

# WRDS. If WRDS_PASSWORD is set, `aim verify` writes ~/.pgpass (mode 600) on first use.
# Otherwise the wrds package uses an existing ~/.pgpass or prompts.
# Expect a Duo push on the first connection from a new machine.
WRDS_USERNAME=
WRDS_PASSWORD=

# Optional: put the data workspace somewhere other than ./data
AIM_DATA_DIR=
